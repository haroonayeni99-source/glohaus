# Copy to .env.local. Never commit secrets.
# Local browser origin; production auth callbacks use the browser's actual origin.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# Canonical public production site used by server-generated email links.
GLOHAUS_PUBLIC_URL=https://glohaus.shop
# Optional override for preview pages that redirect auth to production.
GLOHAUS_PRODUCTION_ORIGIN=https://glohaus.shop
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional for projects still using the previous public-key name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Non-owner, NOINHERIT, NOSUPERUSER, NOBYPASSRLS login with beauty_app membership only.
# Set only in Vercel/server runtime; use a Supabase shared transaction pooler URI.
DATABASE_URL=
# Separate restricted login with beauty_payment_worker membership only.
PAYMENT_DATABASE_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PAYMENT_DATABASE_CA_CERT=
# Operator machine only. NEVER put this credential in the Vercel web deployment.
MIGRATION_DATABASE_URL=
# Stripe test keys initially. Separate platform and Connect webhook signing secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Temporary overlap only; remove after the approved Stripe rotation window.
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS=
# Token for a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Transactional email provider. The verified GLOHAUS sender is used by default.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Separate server-only Resend reader. Receiving and sent-message reads require
# full_access; preserve the existing sending-only website and Gmail SMTP keys.
SUPPORT_EMAIL_API_KEY=
SUPPORT_EMAIL_WEBHOOK_SECRET=
SUPPORT_EMAIL_FORWARDING_ENABLED=false
EMAIL_FROM=GLOHAUS <noreply@glohaus.shop>
# Operator-confirmed production Auth settings. These do not configure Supabase;
# set them to true only after the matching Supabase dashboard setting is enabled.
SUPABASE_CUSTOM_SMTP_CONFIGURED=false
SUPABASE_LEAKED_PASSWORD_PROTECTION_CONFIGURED=false
SUPABASE_AUTH_CAPTCHA_CONFIGURED=false
# Random high-entropy secret for the notification worker endpoint.
CRON_SECRET=

# Web Push: generate one VAPID pair for this application. Private key is server-only.
# Public key is safe to return to signed-in professional browsers; no private key
# or subscription credential belongs in a NEXT_PUBLIC variable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@glohaus.shop

# Optional automatic journey estimates; server-only. Routing remains off until
# provider billing/quotas are reviewed and the Owner enables its separate switch.
GOOGLE_ROUTES_API_KEY=
# Legacy deployments may continue using GOOGLE_MAPS_ROUTES_API_KEY.
# Independent 32-byte random key encoded as 64 hexadecimal characters.
JOURNEY_ROUTING_ENCRYPTION_KEY=

# Optional trusted root CA for verified application database TLS.
# Falls back to PAYMENT_DATABASE_CA_CERT, then the system trust store.
DATABASE_CA_CERT=
