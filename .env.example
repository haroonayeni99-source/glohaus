# Copy to .env.local. Never commit secrets. Match the browser origin exactly.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Non-owner, NOSUPERUSER, NOBYPASSRLS login with beauty_app membership only.
DATABASE_URL=
# Separate restricted login with beauty_payment_worker membership only.
PAYMENT_DATABASE_URL=
# Operator machine only. NEVER put this credential in the Vercel web deployment.
MIGRATION_DATABASE_URL=
# Stripe test keys initially. Separate platform and Connect webhook signing secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Token for a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Transactional email provider; activate only with a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
# Random high-entropy secret for the notification worker endpoint.
CRON_SECRET=
