{
  "name": "glohaus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "runtime:provision": "node --env-file-if-exists=.env.local scripts/provision-runtime-login.mjs",
    "runtime:connection-url": "node --env-file-if-exists=.env.local scripts/runtime-connection-url.mjs",
    "admin:grant": "node --env-file-if-exists=.env.local scripts/grant-admin.mjs",
    "owner:grant": "node --env-file-if-exists=.env.local scripts/grant-owner.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/blob": "^2.8.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.28.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
