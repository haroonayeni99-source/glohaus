{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/example-listings": false,
      "feature/profile-examples": false,
      "feature/home-screen-logo": false,
      "fix/android-notification-open": false,
      "fix/google-routes-key-activation": false,
      "feature/journey-notification-verification": false,
      "feature/home-screen-pwa": false,
      "feature/automatic-journey-routing": false,
      "feature/smart-arrival-journeys": false,
      "feature/multi-speciality": false,
      "fix/session-consistency": false,
      "fix/marketing-preferences": false,
      "feature/homepage-category-names": false,
      "feature/professional-inactivity": false,
      "feature/professional-booking-policies": false,
      "fix/profile-video-autoplay": false,
      "feature/commission-control-centre": false,
      "feature/owner-account-visibility": false,
      "fix/lip-filler-taxonomy": false,
      "feature/professional-notifications": false,
      "feature/discovery-map-categories": false,
      "feature/map-navigation-directions": false,
      "fix/original-map-boroughs": false,
      "security/node-october-2026": false,
      "security/verified-runtime-release": false,
      "security/pinned-container-runtime-20261024": false
    }
  },
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "* * * * *"
    }
  ],
  "services": {
    "web": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
