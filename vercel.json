{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/marketing-preferences": false,
      "feature/homepage-category-names": false,
      "feature/professional-inactivity": false,
      "feature/professional-booking-policies": false,
      "fix/profile-video-autoplay": false,
      "feature/commission-control-centre": false
    }
  },
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "5 * * * *"
    }
  ]
}
